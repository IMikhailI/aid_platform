# Django: DJANGO_SECRET_KEY is mandatory. Generate a unique value locally.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection shared by Django and Docker Compose.
POSTGRES_DB=aid_platform
POSTGRES_USER=aid_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Comma-separated browser origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public API base URL embedded into the Vite frontend build.
VITE_API_BASE_URL=http://localhost:8000
